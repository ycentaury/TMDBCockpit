screen:
  name: "ScreenMain"
  position: "0,0"
  size: "1920,1080"
  children:
    - xmlinc:
        file: "screenpart_TitleBar.ymlinc"
    - widget:
        name: "backdrop"
        position: "0,0"
        scale: "1"
        size: "1920,1080"
        zPosition: "-1"
    - widget:
        font: "$FB_medium"
        foregroundColor: "keyYellow"
        name: "searchinfo"
        position: "30,75"
        size: "1860,50"
        transparent: "1"
    - widget:
        font: "$FR_small"
        itemHeight: "40"
        position: "30,135"
        render: "Listbox"
        scrollbarMode: "showOnDemand"
        size: "1350,840"
        source: "list"
        transparent: "1"
        children:
          - convert:
              type: "StringList"
    - widget:
        name: "cover"
        position: "1410,135"
        scale: "1"
        size: "480,720"
    - ePixmap:
        alphatest: "blend"
        pixmap: "~/../images/tmdb.png"
        position: "1475,880"
        scale: "1"
        size: "350,30"
    - xmlinc:
        file: "screenpart_Footer.ymlinc"
