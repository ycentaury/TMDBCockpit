screen:
  name: "ScreenSeason"
  position: "0,0"
  size: "1920,1080"
  children:
    - xmlinc:
        file: "screenpart_TitleBar.ymlinc"
    - widget:
        name: "backdrop"
        position: "0,0"
        scale: "1"
        size: "1920,1080"
        zPosition: "-1"
    - widget:
        font: "$FB_medium"
        foregroundColor: "keyYellow"
        name: "searchinfo"
        position: "30,75"
        size: "1860,36"
        transparent: "1"
    - widget:
        font: "$FR_small"
        itemHeight: "40"
        position: "30,135"
        render: "Listbox"
        scrollbarMode: "showOnDemand"
        size: "1310,520"
        source: "list"
        transparent: "1"
        children:
          - convert:
              type: "StringList"
    - widget:
        name: "cover"
        position: "1370,135"
        scaleFlags: "scaleCenter"
        size: "520,520"
    - widget:
        font: "$FR_small"
        name: "overview"
        position: "30,650"
        size: "1860,330"
        transparent: "1"
    - xmlinc:
        file: "screenpart_Footer.ymlinc"
