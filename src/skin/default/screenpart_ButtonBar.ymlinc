- xmlinc:
    color: "red"
    file: "screenpart_1Button.ymlinc"
    key: "key_red"
    name: "key_red"
    position: "0,$screen_height-48"
    width: "($screen_width-180)/$4"
- xmlinc:
    color: "green"
    file: "screenpart_1Button.ymlinc"
    key: "key_green"
    name: "key_green"
    position: "($screen_width-180)/$4,$screen_height-48"
    width: "($screen_width-180)/$4"
- xmlinc:
    color: "yellow"
    file: "screenpart_1Button.ymlinc"
    key: "key_yellow"
    name: "key_yellow"
    position: "$2*($screen_width-180)/$4,$screen_height-48"
    width: "($screen_width-180)/$4"
- xmlinc:
    color: "blue"
    file: "screenpart_1Button.ymlinc"
    key: "key_blue"
    name: "key_blue"
    position: "$3*($screen_width-180)/$4,$screen_height-48"
    width: "($screen_width-180)/$4"
- xmlinc:
    color: "white"
    file: "screenpart_1Button.ymlinc"
    key: "key_menu"
    name: "key_menu"
    position: "$screen_width-180,$screen_height-48"
    width: "90"
- xmlinc:
    color: "white"
    file: "screenpart_1Button.ymlinc"
    key: "key_info"
    name: "key_info"
    position: "$screen_width-90,$screen_height-48"
    width: "90"
