screen:
  name: "ScreenMovie"
  position: "0,0"
  size: "1920,1080"
  children:
    - xmlinc:
        file: "screenpart_TitleBar.ymlinc"
    - widget:
        name: "backdrop"
        position: "0,0"
        scale: "1"
        size: "1920,1080"
        zPosition: "-1"
    - widget:
        font: "$FB_medium"
        foregroundColor: "keyYellow"
        name: "searchinfo"
        position: "30,75"
        size: "1860,36"
        transparent: "1"
    - widget:
        font: "$FR_small"
        name: "fulldescription"
        position: "30,135"
        size: "850,840"
        transparent: "1"
    - widget:
        alphatest: "blend"
        name: "cover"
        position: "1410,135"
        scale: "1"
        size: "480,720"
    - widget:
        alphatest: "blend"
        name: "star"
        position: "905,265"
        scale: "1"
        size: "100,100"
        zPosition: "0"
    - widget:
        alphatest: "blend"
        name: "fsklogo"
        position: "1075,280"
        scale: "1"
        size: "100,100"
        zPosition: "2"
    - widget:
        font: "$FR_verysmall"
        foregroundColor: "black"
        halign: "center"
        name: "rating"
        position: "880,305"
        size: "150,25"
        transparent: "1"
        zPosition: "2"
    - widget:
        font: "$FR_verysmall"
        halign: "center"
        name: "votes_brackets"
        position: "880,365"
        size: "150,25"
        transparent: "1"
        zPosition: "2"
    - widget:
        font: "$FR_verysmall"
        name: "year_txt"
        position: "910,415"
        size: "120,28"
        transparent: "1"
    - widget:
        font: "$FR_verysmall"
        name: "year"
        position: "1040,415"
        size: "360,28"
        transparent: "1"
    - widget:
        font: "$FR_verysmall"
        name: "country_txt"
        position: "910,445"
        size: "120,28"
        transparent: "1"
    - widget:
        font: "$FR_verysmall"
        name: "country"
        position: "1040,445"
        size: "340,28"
        transparent: "1"
    - widget:
        font: "$FR_verysmall"
        name: "runtime_txt"
        position: "910,475"
        size: "120,28"
        transparent: "1"
    - widget:
        font: "$FR_verysmall"
        name: "runtime"
        position: "1040,475"
        size: "360,28"
        transparent: "1"
    - widget:
        font: "$FR_verysmall"
        name: "votes_txt"
        position: "910,505"
        size: "130,28"
        transparent: "1"
    - widget:
        font: "$FR_verysmall"
        name: "votes"
        position: "1040,505"
        size: "360,28"
        transparent: "1"
    - widget:
        font: "$FR_verysmall"
        name: "director_txt"
        position: "910,535"
        size: "120,28"
        transparent: "1"
    - widget:
        font: "$FR_verysmall"
        name: "director"
        position: "1040,535"
        size: "360,28"
        transparent: "1"
    - widget:
        font: "$FR_verysmall"
        name: "author_txt"
        position: "910,565"
        size: "120,28"
        transparent: "1"
    - widget:
        font: "$FR_verysmall"
        name: "author"
        position: "1040,565"
        size: "360,28"
        transparent: "1"
    - widget:
        font: "$FR_verysmall"
        name: "genre_txt"
        position: "910,595"
        size: "100,28"
        transparent: "1"
    - widget:
        font: "$FR_verysmall"
        name: "genre"
        position: "1040,595"
        size: "360,28"
        transparent: "1"
    - widget:
        font: "$FR_verysmall"
        name: "studio_txt"
        position: "910,625"
        size: "120,28"
        transparent: "1"
    - widget:
        font: "$FR_verysmall"
        name: "studio"
        position: "1040,625"
        size: "360,28"
        transparent: "1"
    - xmlinc:
        file: "screenpart_Footer.ymlinc"
