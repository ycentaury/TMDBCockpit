- eLabel:
    backgroundColor: "backgroundDark"
    position: "0,0"
    size: "$screen_width,55"
- widget:
    font: "$FB_big"
    position: "10,0"
    render: "Label"
    size: "$screen_width-20,55"
    source: "Title"
    transparent: "1"
    valign: "center"
    zPosition: "1"
- eLabel:
    backgroundColor: "separator"
    position: "0,54"
    size: "$screen_width,2"
